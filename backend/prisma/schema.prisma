generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

model User {
  id           String   @id @default(cuid())
  username     String
  email        String   @unique
  passwordHash String
  submissions  Submission[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model Topic {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String
  difficulty  Difficulty
  orderIndex  Int
  problems    Problem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([orderIndex])
  @@map("topics")
}

model Problem {
  id          String     @id @default(cuid())
  title       String     @unique
  slug        String     @unique
  statement   String
  difficulty  Difficulty
  constraints String
  examples    Json
  hints       Json
  editorial   String?
  starterCode Json
  topicId     String
  topic       Topic      @relation(fields: [topicId], references: [id], onDelete: Restrict)
  submissions Submission[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([topicId])
  @@index([difficulty])
  @@index([createdAt])
  @@map("problems")
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId       String
  problem         Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  code            String
  language        String
  status          SubmissionStatus
  executionTimeMs Int?
  memoryKb        Int?
  testCasesPassed Int?
  totalTestCases  Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([problemId])
  @@index([createdAt])
  @@map("submissions")
}
